# Corpus
RAG_DOCS_DIR=data/docs
RAG_CHUNK_MAX_CHARS=800
RAG_CHUNK_OVERLAP_SENTENCES=1

# Models (downloaded from Hugging Face on first run)
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_TOKEN=

# Retrieval
RAG_SPARSE_TOP_K=20
RAG_DENSE_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_CANDIDATES=20
RAG_FINAL_TOP_K=3
RAG_RERANK_MIN_SCORE=0.1
RAG_CONTEXT_MAX_TOKENS=1500

# Generation (local Ollama server)
RAG_GENERATION_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60
